# Copy to .env and fill in the keys for the tools you want to use.
# Every detector is optional — the app runs whatever is configured and skips the rest.
# Keys stay on the server. They are never sent to the browser.

# --- Sightengine (image) — ~2,000 ops/month free ---
# https://dashboard.sightengine.com/signup
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- AI or Not (image + audio) — the only free-tier option here that covers audio ---
# https://www.aiornot.com
AIORNOT_API_KEY=

# --- Illuminarty (image) ---
# https://illuminarty.ai/en/api-docs
ILLUMINARTY_API_KEY=

# --- App settings ---
PORT=3000
MAX_UPLOAD_MB=25
DETECTOR_TIMEOUT_MS=30000

# Fill unconfigured tools with simulated scores so the interface is usable
# without any API keys. Clearly labelled in the UI. Never leave this on in production.
DEMO_MODE=false

# --- Endpoint overrides ---
# Providers move endpoints and rename fields; these let you correct that
# without a code change. Leave blank to use the built-in defaults.
# SIGHTENGINE_API_URL=
# AIORNOT_IMAGE_URL=
# AIORNOT_AUDIO_URL=
# AIORNOT_FILE_FIELD=
# ILLUMINARTY_API_URL=
# ILLUMINARTY_FILE_FIELD=
